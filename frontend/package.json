{
  "name": "isobar-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build --configLoader runner",
    "lint": "vue-tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "build:firebase": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode firebase --configLoader runner"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
