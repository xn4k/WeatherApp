# Firebase Core wird immer initialisiert.
# Analytics erst nach einer Einwilligungsloesung aktivieren.
VITE_FIREBASE_ANALYTICS_ENABLED=false


# Public Firebase Web configuration. Copy values into .env.firebase.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
