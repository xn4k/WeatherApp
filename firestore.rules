rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Published forecasts are intentionally public. Only trusted Admin SDK
    // collectors can write; Admin requests bypass these client rules.
    match /publicWeather/{locationId} {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
